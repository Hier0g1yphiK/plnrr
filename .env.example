# =============================================================================
# plnrr Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control — it contains secrets.

# Database (Neon Postgres)
# DATABASE_URL is the pooled connection used at runtime by Prisma Client.
# DIRECT_URL is the non-pooled connection used by Prisma Migrate.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Auth.js
# Generate a secret with: npx auth secret
AUTH_SECRET="your-auth-secret-here"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Access Control
# Comma-separated list of email addresses allowed to sign in.
# If empty or missing, ALL sign-in attempts will be rejected.
ALLOWED_EMAILS="user1@example.com,user2@example.com"

# =============================================================================
# Deployment Notes
# =============================================================================
#
# Prisma Migrate in production:
#   prisma migrate deploy MUST run against the non-pooled connection (DIRECT_URL),
#   not the pooled DATABASE_URL. Neon's connection pooler does not support the
#   advisory locks that Prisma Migrate requires.
#
#   Use this pattern in your deploy script or CI:
#     DATABASE_URL=$DIRECT_URL npx prisma migrate deploy
#
# Vercel environment variables:
#   Set all variables above in your Vercel project settings under
#   Settings > Environment Variables. They are injected at deploy time.
